{
    "name"             : "joomlashack/osdownloads",
    "description"      : "OSDownloads Free",
    "minimum-stability": "stable",
    "license"          : "GPL-2.0-or-later",
    "type"             : "joomla-component",
    "extra"            : {
        "element"        : "com_osdownloads",
        "element-short"  : "osdownloads",
        "name"           : "OSDownloads",
        "client"         : "administrator",
        "package-license": "free",
        "target-platform": ".*",
        "infourl"        : "/changelog/osdownloads/"
    },
    "authors"          : [
        {
            "name" : "Joomlashack",
            "email": "help@joomlashack.com"
        }
    ],
    "config"           : {
        "vendor-dir": "src/admin/vendor"
    },
    "require"          : {
        "php"                   : ">=8.1",
        "ext-curl"              : "*",
        "ext-fileinfo"          : "*",
        "ext-simplexml"         : "*",
        "ext-json"              : "*",
        "ext-openssl"           : "*",
        "mailchimp/marketing": "^3.0"
    },
    "replace": {
        "psr/container": "*"
    },
    "scripts"          : {
        "test"    : [
            "@composer --working-dir=tests install --no-interaction --quiet",
            "@php tests/vendor/codeception/codeception/codecept run"
        ],
        "lint"    : [
            "@composer --working-dir=tests install --no-interaction --quiet",
            "@php tests/vendor/squizlabs/php_codesniffer/bin/phpcs --standard=PSR12 --extensions=php -sp --ignore='src/admin/vendor/*,tests/vendor/*,tests/_output/*,tests/Support/_generated/*' src tests"
        ],
        "lint:fix": [
            "@composer --working-dir=tests install --no-interaction --quiet",
            "@php tests/vendor/squizlabs/php_codesniffer/bin/phpcbf --standard=PSR12 --extensions=php --ignore='src/admin/vendor/*,tests/vendor/*,tests/_output/*,tests/Support/_generated/*' src tests"
        ],
        "analyse" : [
            "@composer --working-dir=tests install --no-interaction --quiet",
            "@php tests/vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "check"   : [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test"    : "Install test dependencies into tests/vendor and run the Codeception suite",
        "lint"    : "Check src and tests against the PSR-12 coding standard",
        "lint:fix": "Automatically fix PSR-12 violations that phpcbf can correct",
        "analyse" : "Run PHPStan static analysis on src against a Joomla checkout",
        "check"   : "Run lint, analyse and test, stopping at the first failure"
    }
}
